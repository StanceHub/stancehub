# App
BETTER_AUTH_SECRET=dev-secret-change-me-to-32chars-min
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# CE (TENANCY_RLS=0): single owner/bypass URL is fine.
DATABASE_URL=postgresql://stancehub:stancehub@localhost:5433/stancehub
# Enterprise (TENANCY_RLS=1): app = non-bypass role; admin = migrate/worker.
# DATABASE_URL=postgresql://stancehub_app:stancehub@localhost:5433/stancehub
# DATABASE_URL_ADMIN=postgresql://stancehub:stancehub@localhost:5433/stancehub
# TENANCY_RLS=1
# Enterprise: store truncated ask query text in audit_events (max 80 chars). Default off.
# AUDIT_STORE_QUERY_TEXT=1

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# --- Embeddings (vault retrieval) ---
# Prefer dedicated EMBEDDING_* hosts. LLM_* remains a migration fallback only.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=embed
EMBEDDING_DIMENSIONS=768

# --- Chat (summarize / ask) ---
# Enterprise pattern: generative LLM is separate from embeddings.
# Option A (recommended): local Ollama daemon as OpenAI-compatible proxy; cloud model
# runs remotely (no local chat weights). Sign in: `ollama signin`, then:
#   ollama pull gpt-oss:20b-cloud
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_API_KEY=ollama
# Or: CHAT_API_KEY / OLLAMA_API_KEY from https://ollama.com keys
LLM_MODEL=gpt-oss:20b-cloud
CHAT_TIMEOUT_MS=120000
# Completion budget for summarize (reasoning models need headroom; default 4096, max 8192)
SUMMARIZE_MAX_TOKENS=4096
# Completion budget for ask answers (default 2048; bumps once on truncation)
ASK_MAX_TOKENS=2048

# Shared fallbacks (optional). Used only when EMBEDDING_* / CHAT_* are unset.
# Do NOT point both chat and embed at a single-purpose cloud host unless both models exist there.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama

# Worker chunking (characters). Changing this requires re-embed of existing meetings.
CHUNK_MAX_CHARS=480
