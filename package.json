{
  "name": "stancehub",
  "private": true,
  "version": "0.0.1",
  "description": "StanceHub MVP monorepo — self-hostable organizational meeting memory",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:web": "dotenv -e .env -- pnpm --filter @stancehub/web dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @stancehub/worker dev",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "dotenv -e .env -- pnpm --filter @stancehub/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @stancehub/db migrate",
    "db:push": "dotenv -e .env -- pnpm --filter @stancehub/db push",
    "compose:up": "docker compose -f deploy/docker-compose.yml up -d",
    "compose:down": "docker compose -f deploy/docker-compose.yml down",
    "compose:ps": "docker compose -f deploy/docker-compose.yml ps"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
